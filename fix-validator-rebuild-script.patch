diff --git a/r3tards-validator-stake-audit/rebuild-validator-summary.mjs b/r3tards-validator-stake-audit/rebuild-validator-summary.mjs
new file mode 100644
index 0000000..d23dc51
--- /dev/null
+++ b/r3tards-validator-stake-audit/rebuild-validator-summary.mjs
@@ -0,0 +1,133 @@
+import fs from 'node:fs';
+import path from 'node:path';
+
+const ROOT = path.resolve('..');
+const CFG = JSON.parse(fs.readFileSync(path.join(ROOT, 'config.json'), 'utf8'));
+const OUT = path.resolve('validator-stake-output');
+const GENERATED_AT = process.env.AUDIT_GENERATED_AT || CFG.reproducibleBuild?.generatedAt || 'snapshot-77822541';
+const SNAPSHOT_BLOCK = Number(CFG.snapshotBlock);
+
+function readJson(file) {
+  return JSON.parse(fs.readFileSync(path.join(OUT, file), 'utf8'));
+}
+
+function parseCsvLine(line) {
+  const out = [];
+  let cur = '';
+  let quoted = false;
+  for (let i = 0; i < line.length; i++) {
+    const c = line[i];
+    const n = line[i + 1];
+    if (c === '"' && quoted && n === '"') {
+      cur += '"';
+      i++;
+    } else if (c === '"') {
+      quoted = !quoted;
+    } else if (c === ',' && !quoted) {
+      out.push(cur);
+      cur = '';
+    } else {
+      cur += c;
+    }
+  }
+  out.push(cur);
+  return out;
+}
+
+function parseCsv(file) {
+  const full = path.join(OUT, file);
+  if (!fs.existsSync(full)) return [];
+  const text = fs.readFileSync(full, 'utf8').trim();
+  if (!text) return [];
+  const lines = text.split(/\r?\n/).filter(Boolean);
+  const headers = parseCsvLine(lines.shift()).map(h => h.trim());
+  return lines.map(line => {
+    const cells = parseCsvLine(line);
+    return Object.fromEntries(headers.map((h, i) => [h, (cells[i] || '').trim()]));
+  });
+}
+
+function sumMON(rows) {
+  return rows.reduce((acc, row) => acc + Number(row.amountMON || 0), 0);
+}
+
+function sameAddress(a, b) {
+  return String(a || '').toLowerCase() === String(b || '').toLowerCase();
+}
+
+function writeJson(file, value) {
+  fs.writeFileSync(path.join(OUT, file), JSON.stringify(value, null, 2) + '\n');
+}
+
+const validatorState = readJson('validator_state.json');
+const specificDelegatorState = readJson('specific_delegator_state.json');
+const delegateRows = parseCsv('delegation_events.csv').filter(row => Number(row.blockNumber) <= SNAPSHOT_BLOCK);
+const undelegateRows = parseCsv('undelegation_events.csv').filter(row => Number(row.blockNumber) <= SNAPSHOT_BLOCK);
+const targetDelegator = specificDelegatorState?.delegator || CFG.deployerWallet;
+const specificDelegateRows = parseCsv('specific_delegator_delegation_events.csv').filter(row => Number(row.blockNumber) <= SNAPSHOT_BLOCK && sameAddress(row.delegator, targetDelegator));
+const specificUndelegateRows = parseCsv('specific_delegator_undelegation_events.csv').filter(row => Number(row.blockNumber) <= SNAPSHOT_BLOCK && sameAddress(row.delegator, targetDelegator));
+const delegatorRows = parseCsv('delegators.csv');
+
+const grossDelegated = sumMON(delegateRows);
+const grossUndelegated = sumMON(undelegateRows);
+const specificGrossDelegated = sumMON(specificDelegateRows);
+const specificGrossUndelegated = sumMON(specificUndelegateRows);
+const delegatorStakeSum = delegatorRows.reduce((acc, row) => acc + Number(row.stakeMON || 0), 0);
+const delegatorRewardsSum = delegatorRows.reduce((acc, row) => acc + Number(row.unclaimedRewardsMON || 0), 0);
+
+const summary = {
+  generatedAt: GENERATED_AT,
+  network: 'Monad mainnet',
+  chainId: CFG.chainId,
+  rpcUrl: 'redacted/read-only RPC; see fetch command in README',
+  blockTag: validatorState.blockTag || 'unknown',
+  validatorStateBlockTag: validatorState.blockTag || 'unknown',
+  validatorNameSearch: CFG.validator?.name || 'forthenads',
+  validatorId: Number(validatorState.validatorId ?? CFG.validator?.id),
+  stakingPrecompile: validatorState.stakingPrecompile || CFG.validator?.stakingPrecompile,
+  authAddress: validatorState.authAddress,
+  epoch: validatorState.epoch,
+  executionStakeMON: validatorState.executionStakeMON,
+  consensusStakeMON: validatorState.consensusStakeMON,
+  snapshotStakeMON: validatorState.snapshotStakeMON,
+  unclaimedRewardsMON: validatorState.unclaimedRewardsMON,
+  executionCommissionPercent: validatorState.executionCommissionPercent,
+  consensusCommissionPercent: validatorState.consensusCommissionPercent,
+  snapshotCommissionPercent: validatorState.snapshotCommissionPercent,
+  delegatorCountChecked: delegatorRows.length,
+  delegatorStakeSumMON: delegatorRows.length ? String(delegatorStakeSum) : null,
+  delegatorUnclaimedRewardsSumMON: delegatorRows.length ? String(delegatorRewardsSum) : null,
+  specificDelegatorAddress: specificDelegatorState?.delegator || null,
+  specificDelegatorCurrentStakeMON: specificDelegatorState?.stakeMON || null,
+  specificDelegatorUnclaimedRewardsMON: specificDelegatorState?.unclaimedRewardsMON || null,
+  specificDelegatorDeltaStakeMON: specificDelegatorState?.deltaStakeMON || null,
+  specificDelegatorNextDeltaStakeMON: specificDelegatorState?.nextDeltaStakeMON || null,
+  eventHistoryEnabled: delegateRows.length > 0 || undelegateRows.length > 0,
+  eventStartBlock: String(CFG.startBlock),
+  eventEndBlock: String(SNAPSHOT_BLOCK),
+  eventWindowCanonicalToSnapshot: true,
+  delegateEventCount: delegateRows.length,
+  undelegateEventCount: undelegateRows.length,
+  grossDelegatedMONByEvents: String(grossDelegated),
+  grossUndelegatedMONByEvents: String(grossUndelegated),
+  netDelegatedMONByEvents: String(grossDelegated - grossUndelegated),
+  specificDelegatorDelegateEventCount: specificDelegateRows.length,
+  specificDelegatorUndelegateEventCount: specificUndelegateRows.length,
+  specificDelegatorGrossDelegatedMONByEvents: String(specificGrossDelegated),
+  specificDelegatorGrossUndelegatedMONByEvents: String(specificGrossUndelegated),
+  specificDelegatorNetDelegatedMONByEvents: String(specificGrossDelegated - specificGrossUndelegated),
+  snapshotBlock: SNAPSHOT_BLOCK,
+  notes: [
+    'This file is rebuilt offline from committed validator_state/specific_delegator_state JSON plus committed delegate/undelegate CSV evidence.',
+    'Delegate/undelegate event totals are bounded to the canonical snapshot block when eventWindowCanonicalToSnapshot is true.',
+    'Validator and specific-delegator state files record blockTag=latest; do not describe those state reads as historical snapshot reads unless refetched with BLOCK_TAG=77822541.',
+    'executionStakeMON is the staking precompile execution view for the recorded validator_state blockTag.',
+    'consensusStakeMON is the stake currently used by consensus for the recorded validator_state blockTag.',
+    'snapshotStakeMON is the staking snapshot view for epoch transition logic at the recorded validator_state blockTag.',
+    'Event totals are historical flow metrics. Current on-chain validator state is reported separately from event math.',
+    'Validator stake is not creator revenue; it is MON committed to validator operations.'
+  ]
+};
+
+writeJson('summary.json', summary);
+console.log(`Wrote ${path.join(OUT, 'summary.json')}`);
